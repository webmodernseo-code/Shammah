# La même base Neon et le même secret doivent être utilisés par le site et le dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
NEXTAUTH_SECRET="replace_with_the_same_random_secret_as_the_web_app"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DASHBOARD_URL="http://localhost:3001"
CRON_SECRET="replace_with_an_independent_random_secret"
SECRETS_ENCRYPTION_KEY="replace_with_32_random_bytes_encoded_as_base64"
NEXT_PUBLIC_DEMO_MODE="false"
